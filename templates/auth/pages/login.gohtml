{{- define "content" -}}
<section class="auth-card">
  <div class="auth-head">
    {{ template "brandMark" }}
    <h1 class="auth-title">3270Connect</h1>
  </div>
  <p class="auth-sub">Sign in to reach the operations console.</p>

  {{/* Both above the form: they are what to read before typing a password
       into it, not a footnote to having typed one. */}}
  {{ template "tlsWarning" . }}
  {{ template "formMessages" . }}

  {{ if .SSOEnabled }}
  <a class="auth-submit auth-submit-link" href="{{ .SSOStartPath }}?next={{ .Next }}">Sign in with your organisation account</a>
  <div class="auth-divider"><span>or sign in with a password</span></div>
  {{ end }}

  <form action="/login" method="post" class="auth-form" autocomplete="on">
    <input type="hidden" name="next" value="{{ .Next }}">

    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" autocomplete="username"
             autocapitalize="none" autocorrect="off" spellcheck="false"
             required autofocus>
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password"
             autocomplete="current-password" required>
    </div>

    <button type="submit" class="auth-submit">Sign in</button>
  </form>

  {{ if .SSOEnabled }}
  <p class="auth-note">
    The password form is here on purpose: it is the way back in when the
    identity provider cannot be reached.
  </p>
  {{ else }}
  <p class="auth-note">
    No account yet? An administrator creates one, or so does the console
    command <code>3270Connect user add &lt;name&gt;</code>.
  </p>
  {{ end }}
</section>
{{- end -}}
