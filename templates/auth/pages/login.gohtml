{{- define "content" -}}
<section class="auth-card">
  <div class="auth-head">
    {{ template "brandMark" }}
    <h1 class="auth-title">3270Connect</h1>
  </div>
  <p class="auth-sub">Sign in to reach the operations console.</p>

  {{ template "formMessages" . }}

  {{ if .SSOEnabled }}
  <a class="auth-submit auth-submit-link" href="{{ .SSOStartPath }}?next={{ .Next }}">Sign in with your organisation account</a>
  <div class="auth-divider"><span>or sign in with a password</span></div>
  {{ end }}

  <form action="/login" method="post" class="auth-form" autocomplete="on">
    <input type="hidden" name="next" value="{{ .Next }}">

    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" autocomplete="username"
             autocapitalize="none" autocorrect="off" spellcheck="false"
             required autofocus>
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password"
             autocomplete="current-password" required>
    </div>

    <button type="submit" class="auth-submit">Sign in</button>
  </form>

  {{/* Nothing below the button but the connection warning, and that only on a
       connection that has earned it. Where somebody has no account the answer
       is an administrator or `3270Connect user add <name>`, and that belongs
       in the documentation rather than under every sign-in this console ever
       serves — the card is a door, not a manual. */}}
  {{ template "tlsWarning" . }}
</section>
{{- end -}}
