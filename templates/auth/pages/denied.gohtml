{{- define "content" -}}
<section class="card card-narrow">
  <header class="card-head">
    <img class="mark" src="/static/images/favicon.png" alt="" width="40" height="40">
    <h1>{{ .Title }}</h1>
  </header>

  <p class="banner banner-error" role="alert">{{ .Message }}</p>

  <p class="hint">
    Administration covers the whole instance: accounts, groups, tokens, other
    people's load runs and the audit trail. Running your own workflows does not
    need it.
  </p>

  <a class="btn btn-primary btn-block" href="/dashboard">Back to the console</a>
</section>
{{- end -}}
