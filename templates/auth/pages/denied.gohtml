{{- define "content" -}}
<section class="auth-card">
  <div class="auth-head">
    {{ template "brandMark" }}
    <h1 class="auth-title">{{ .Title }}</h1>
  </div>

  <div class="auth-alert auth-alert--error" role="alert"><span>{{ .Message }}</span></div>

  <p class="auth-sub">
    Administration covers the whole instance: accounts, groups, tokens, other
    people's load runs and the audit trail. Running your own workflows does not
    need it.
  </p>

  <a class="auth-submit auth-submit-link" href="/dashboard">Back to the console</a>
</section>
{{- end -}}
