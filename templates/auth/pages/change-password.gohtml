{{- define "content" -}}
<section class="card card-narrow">
  <header class="card-head">
    <img class="mark" src="/static/images/favicon.png" alt="" width="40" height="40">
    <h1>Change your password</h1>
    {{ if .Forced }}
    <p class="sub">This password was issued to you, so it has to be replaced</p>
    {{ end }}
  </header>

  {{ template "formMessages" . }}

  {{ if .Forced }}
  <p class="banner banner-info">
    Somebody else typed the password you signed in with, and probably sent it
    over chat. Choosing your own is the only thing this account can do until it
    is done.
  </p>
  {{ end }}

  <form method="post" action="/account/password" autocomplete="on">
    <label for="currentPassword">Current password</label>
    <input id="currentPassword" name="currentPassword" type="password"
           autocomplete="current-password" required autofocus>

    <label for="newPassword">New password</label>
    <input id="newPassword" name="newPassword" type="password"
           autocomplete="new-password" minlength="{{ .MinLength }}" required>

    <label for="confirmPassword">Confirm new password</label>
    <input id="confirmPassword" name="confirmPassword" type="password"
           autocomplete="new-password" minlength="{{ .MinLength }}" required>

    <p class="hint">
      At least {{ .MinLength }} characters. Changing it signs this account out
      everywhere else, which is usually the point of changing one.
    </p>

    <button class="btn btn-primary btn-block" type="submit">Change password</button>
  </form>

  {{ if not .Forced }}
  <p class="hint"><a href="/dashboard">Back to the console</a></p>
  {{ end }}
</section>
{{- end -}}
