{{- define "content" -}}
<section class="auth-card">
  <div class="auth-head">
    {{ template "brandMark" }}
    <h1 class="auth-title">Change your password</h1>
  </div>
  {{ if .Forced }}
  <p class="auth-sub">This password was issued to you, so it has to be replaced.</p>
  {{ else }}
  <p class="auth-sub">Choose a new password for this account.</p>
  {{ end }}

  {{ template "formMessages" . }}

  {{ if .Forced }}
  <div class="auth-alert auth-alert--info">
    <span>
      Somebody else typed the password you signed in with, and probably sent it
      over chat. Choosing your own is the only thing this account can do until
      it is done.
    </span>
  </div>
  {{ end }}

  <form action="/account/password" method="post" class="auth-form" autocomplete="on">
    <div class="field">
      <label for="currentPassword">Current password</label>
      <input type="password" id="currentPassword" name="currentPassword"
             autocomplete="current-password" required autofocus>
    </div>

    <div class="field">
      <label for="newPassword">New password</label>
      <input type="password" id="newPassword" name="newPassword"
             autocomplete="new-password" minlength="{{ .MinLength }}" required>
    </div>

    <div class="field">
      <label for="confirmPassword">Confirm new password</label>
      <input type="password" id="confirmPassword" name="confirmPassword"
             autocomplete="new-password" minlength="{{ .MinLength }}" required>
      <p class="field-hint">
        At least {{ .MinLength }} characters. Changing it signs this account out
        everywhere else, which is usually the point of changing one.
      </p>
    </div>

    <button type="submit" class="auth-submit">Change password</button>
  </form>

  {{ if not .Forced }}
  <p class="auth-note"><a href="/dashboard">Back to the console</a></p>
  {{ end }}
</section>
{{- end -}}
