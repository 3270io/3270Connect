{{/* The shell every sign-in and administration page is served in.

     Parsed alongside exactly one page at a time (see parseAuthPages), so the
     blocks below belong to that page and cannot be overwritten by the next
     one. */}}
{{- define "layout" -}}
<!doctype html>
<html lang="en" data-theme="phosphor">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="robots" content="noindex, nofollow">
  <title>{{ .Title }} — 3270Connect</title>
  <link rel="shortcut icon" href="/static/images/favicon.png" type="image/png">
  <link rel="stylesheet" href="/static/css/auth.css?v={{ .Version }}">
</head>
<body class="{{ block "bodyClass" . }}page-centred{{ end }}">
{{ block "chrome" . }}{{ end }}
<main class="{{ block "mainClass" . }}auth-wrap{{ end }}">
{{ block "content" . }}{{ end }}
</main>
{{/* The footer belongs to the administration area, not to the sign-in card.
     A card with a rule, a note and a footer under it is three endings; the
     version and the documentation link are worth having where somebody is
     already working, and in the way where they are trying to get in.

     Keyed on Active because that is what tells the two apart: an
     administration page names the tab it is, and a centred page names
     nothing. */}}
{{ if .Active }}
<footer class="page-footer">
  <span>3270Connect {{ .Version }}</span>
  <a href="https://3270connect.3270.io/authentication/" rel="noreferrer">Documentation</a>
</footer>
{{ end }}
{{ block "scripts" . }}{{ end }}
</body>
</html>
{{- end -}}

{{/* The 3270Connect mark: the session stack — terminal screens receding in
     depth, one workflow driving many. 3270Connect's variant carries the
     chevrons of a script stepping through them.

     Inlined rather than served as an image because an <img>-loaded SVG cannot
     see the page's custom properties: drawn here, it reads --accent and
     --accent-2 and re-tints with the palette. The generated source is
     brand/3270connect-mark-themed.svg — regenerate it from the brand kit
     rather than editing the geometry here. The one edit it carries is the
     filter's flood-color, which moved to auth.css because these pages are
     served under a policy that allows no inline style. */}}
{{- define "brandMark" -}}
<svg class="brand-mark" viewBox="21 28.5 96 88" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="mark-face" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="var(--accent-2)"/>
      <stop offset="1" stop-color="var(--accent)"/>
    </linearGradient>
    <linearGradient id="mark-spec" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.26"/>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.03"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <filter id="mark-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="5" stdDeviation="6" flood-opacity="0.45"/>
    </filter>
    <mask id="mark-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="128" height="128">
      <rect width="128" height="128" fill="#fff"/>
      <g fill="#000">
        <path d="M52 59 62 69 52 79" fill="none" stroke="#000" stroke-width="7"
              stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M67 59 77 69 67 79" fill="none" stroke="#000" stroke-width="7"
              stroke-linecap="round" stroke-linejoin="round"/>
      </g>
    </mask>
    <clipPath id="mark-face-clip">
      <rect x="30" y="46" width="70" height="46" rx="11"/>
    </clipPath>
  </defs>

  <!-- Receding planes: the sessions behind the one in front. -->
  <rect x="54" y="39" width="54" height="46" rx="9" fill="var(--accent)" fill-opacity="0.2"/>
  <rect x="42" y="42.5" width="62" height="46" rx="10" fill="var(--accent)" fill-opacity="0.38"/>

  <g filter="url(#mark-glow)">
    <rect x="30" y="46" width="70" height="46" rx="11"
          fill="url(#mark-face)" mask="url(#mark-cut)"/>
  </g>

  <!-- Specular sweep, clipped to the front face. -->
  <g clip-path="url(#mark-face-clip)">
    <path d="M30 46h70v20L30 84Z" fill="url(#mark-spec)"/>
  </g>
</svg>
{{- end -}}

{{/* The warning a form closes with when the connection is not encrypted.

     Below the form rather than above it: it is a fact about the page, not an
     instruction for filling it in, and above the fields it pushes the thing
     somebody came to do off a phone screen.

     Two messages, because they need two different actions. Nothing in front of
     the console means "put TLS in front of it". Something in front saying it
     terminated TLS means this server has simply not been told to believe the
     header, which is one environment variable away — and a warning that only
     describes the symptom gets ignored. */}}
{{- define "tlsWarning" -}}
{{ if .ShowNoTLS }}
  {{ if .ProxySaysHTTPS }}
  <div class="auth-alert auth-alert--info auth-alert--foot">
    <span>
      Something in front of this console says the browser reached it over
      HTTPS, but 3270Connect has not been told to believe forwarding headers,
      so the sign-in cookie will not be marked <code>Secure</code>. Set
      <code>TRUST_PROXY_HEADERS=true</code>.
    </span>
  </div>
  {{ else }}
  <div class="auth-alert auth-alert--warn auth-alert--foot">
    <span>
      This connection is not encrypted. Anything typed here, the password
      included, crosses the network in the clear. Put TLS in front of the
      console before using it over anything but localhost.
    </span>
  </div>
  {{ end }}
{{ end }}
{{- end -}}

{{- define "formMessages" -}}
{{ if .Error }}
<div class="auth-alert auth-alert--error" role="alert" aria-live="assertive"><span>{{ .Error }}</span></div>
{{ end }}
{{ if .Notice }}
<div class="auth-alert auth-alert--info"><span>{{ .Notice }}</span></div>
{{ end }}
{{- end -}}

{{/* The administration area's header: where you are, who you are, and the way
     back to the console you came from. */}}
{{- define "adminChrome" -}}
<header class="admin-topbar">
  <a class="admin-brand" href="/dashboard">
    <img src="/static/images/favicon.png" alt="" width="26" height="26">
    <span>3270Connect</span>
    <span class="tag">Administration</span>
  </a>
  <div class="admin-who">
    {{ if .Auth.SignedIn }}
      <span class="chip">{{ .Auth.Username }}</span>
      <a class="btn btn-quiet" href="/account/password">Password</a>
      <a class="btn btn-quiet" href="/logout">Sign out</a>
    {{ else }}
      <span class="chip chip-muted">no sign-in configured</span>
    {{ end }}
    <a class="btn btn-quiet" href="/dashboard">Console</a>
  </div>
</header>
<nav class="admin-nav" aria-label="Administration">{{ adminNav .Active }}</nav>
{{ if eq .AuthMode "none" }}
<p class="banner banner-info banner-wide">
  This console has no sign-in: <code>AUTH_MODE</code> is <code>none</code>, so
  everything below describes an instance with one operator. Accounts, groups
  and tokens need <code>AUTH_MODE=local</code> or <code>AUTH_MODE=oidc</code>.
  <a href="https://3270connect.3270.io/authentication/" rel="noreferrer">How to turn it on</a>.
</p>
{{ end }}
{{- end -}}
