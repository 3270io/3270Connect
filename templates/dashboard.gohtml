<symbol id="i-arrow-up-right-from-square" viewBox="0 0 512 512"><path d="M320 0c-17.7 0-32 14.3-32 32s14.3 32 32 32h82.7L201.4 265.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L448 109.3V192c0 17.7 14.3 32 32 32s32-14.3 32-32V32c0-17.7-14.3-32-32-32H320zM80 32C35.8 32 0 67.8 0 112V432c0 44.2 35.8 80 80 80H400c44.2 0 80-35.8 80-80V320c0-17.7-14.3-32-32-32s-32 14.3-32 32V432c0 8.8-7.2 16-16 16H80c-8.8 0-16-7.2-16-16V112c0-8.8 7.2-16 16-16H192c17.7 0 32-14.3 32-32s-14.3-32-32-32H80z"/></symbol>
<symbol id="i-filter" viewBox="0 0 512 512"><path d="M3.9 54.9C10.5 40.9 24.5 32 40 32H472c15.5 0 29.5 8.9 36.1 22.9s4.6 30.5-5.2 42.5L320 320.9V448c0 12.1-6.8 23.2-17.7 28.6s-23.8 4.3-33.5-3l-64-48c-8.1-6-12.8-15.5-12.8-25.6V320.9L9 97.3C-.7 85.4-2.8 68.8 3.9 54.9z"/></symbol>
<symbol id="i-sliders" viewBox="0 0 512 512"><path d="M0 416c0 17.7 14.3 32 32 32l54.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48L480 448c17.7 0 32-14.3 32-32s-14.3-32-32-32l-246.7 0c-12.3-28.3-40.5-48-73.3-48s-61 19.7-73.3 48L32 384c-17.7 0-32 14.3-32 32zm128 0a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zM320 256a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm32-80c-32.8 0-61 19.7-73.3 48L32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l246.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48l54.7 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-54.7 0c-12.3-28.3-40.5-48-73.3-48zM192 128a32 32 0 1 1 0-64 32 32 0 1 1 0 64zm73.3-64C253 35.7 224.8 16 192 16s-61 19.7-73.3 48L32 64C14.3 64 0 78.3 0 96s14.3 32 32 32l86.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48L480 128c17.7 0 32-14.3 32-32s-14.3-32-32-32L265.3 64z"/></symbol>
  </svg>
  <div class="backdrop" aria-hidden="true"></div>

  <div class="shell">

    <!-- ================= Topbar ================= -->
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark"><img src="/static/images/logo.png" alt=""></span>
        <span class="brand-text">
          <span class="name">3270<b>CONNECT</b></span>
          <span class="eyebrow">Operations Console · v{{.Version}}</span>
        </span>
      </div>

      <div class="topbar-live" role="status" aria-live="polite">
        <span class="dot" id="liveDot"></span>
        <span id="liveState">IDLE</span>
        <span class="sep"></span>
        <span><span id="liveProcesses">0</span> proc</span>
        <span class="sep"></span>
        <span><span id="liveActive">0</span> active</span>
        <span class="sep"></span>
        <span id="uptimeClock">0s</span>
      </div>

      <div class="topbar-spacer"></div>

      <div class="topbar-actions">
        <button class="palette-trigger" id="paletteTrigger" type="button" aria-label="Open command palette">
          <svg class="ic" aria-hidden="true"><use href="#i-magnifying-glass"></use></svg>
          <span class="grow">Search commands…</span>
          <kbd>Ctrl K</kbd>
        </button>

        <button class="btn-x primary" id="openStartProcess" type="button" data-tip="Start a 3270Connect run (S)">
          <svg class="ic" aria-hidden="true"><use href="#i-rocket"></use></svg><span class="txt">Start Process</span>
        </button>
        <button class="btn-x accentline" id="openStartApp" type="button" data-tip="Launch a bundled sample 3270 app (A)">
          <svg class="ic" aria-hidden="true"><use href="#i-server"></use></svg><span class="txt">Start App</span>
        </button>
        <button class="btn-x icon" id="openConsole" type="button" data-tip="Console logs (C)" aria-label="Console logs">
          <svg class="ic" aria-hidden="true"><use href="#i-terminal"></use></svg>
        </button>
        <button class="btn-x icon" id="refreshNow" type="button" data-tip="Refresh now (R)" aria-label="Refresh now">
          <svg class="ic" aria-hidden="true"><use href="#i-rotate"></use></svg>
        </button>
        <button class="btn-x icon" id="openShortcuts" type="button" data-tip="Keyboard shortcuts (?)" aria-label="Keyboard shortcuts">
          <svg class="ic" aria-hidden="true"><use href="#i-keyboard"></use></svg>
        </button>

        <!-- Who is here, and the way out again.

             CanAdminister rather than IsAdmin: with no sign-in there is no
             principal to be an administrator, but the single operator may do
             everything the area offers, and hiding it from them would hide it
             from the one person the default deployment is for.

             The signed-in chip and Sign out only appear where there is a
             sign-in to appear for. Without one there is nobody to name and
             nothing to sign out of. -->
        {{ if .Auth.CanAdminister }}
        <a class="btn-x accentline" href="/admin" data-tip="Accounts, groups, tokens, runs and the audit trail">
          <svg class="ic" aria-hidden="true"><use href="#i-server"></use></svg><span class="txt">Admin</span>
        </a>
        {{ end }}
        {{ if .Auth.SignedIn }}
        <span class="signed-in" data-tip="Signed in">{{ .Auth.Username }}</span>
        <a class="btn-x icon" href="/logout" data-tip="Sign out" aria-label="Sign out">
          <svg class="ic" aria-hidden="true"><use href="#i-plug-circle-xmark"></use></svg>
        </a>
        {{ end }}
      </div>
    </header>

    <div class="offline-bar" role="alert">
      <svg class="ic" aria-hidden="true"><use href="#i-plug-circle-xmark"></use></svg>
      <span>Lost contact with the dashboard server. Showing the last known snapshot and retrying automatically.</span>
    </div>

    <!-- ================= Status bar ================= -->
    <div class="statusbar">
      <div class="group">
        <div class="refresh-ring" id="refreshRing" aria-hidden="true">
          <svg viewBox="0 0 30 30">
            <circle class="track" cx="15" cy="15" r="12" fill="none" stroke-width="2"></circle>
            <circle class="bar" id="refreshRingBar" cx="15" cy="15" r="12" fill="none" stroke-width="2"
                    stroke-dasharray="75.4" stroke-dashoffset="75.4"></circle>
          </svg>
          <span class="glyph"><svg class="ic" aria-hidden="true"><use href="#i-bolt"></use></svg></span>
        </div>
        <div class="refresh-meta" aria-live="polite">
          <span class="primary" id="refreshStamp">Updated --:--:--</span>
          <span class="secondary" id="refreshStatus">Starting up…</span>
        </div>
      </div>

      <div class="group">
        <label class="switch" data-tip="Pause or resume live polling (P)">
          <input type="checkbox" id="autoRefreshToggle" {{if .AutoRefreshEnabled}}checked{{end}}>
          <span class="track"></span>
          <span class="switch-label">Live</span>
        </label>
        <div class="segmented" id="intervalPicker" role="group" aria-label="Refresh interval">
          <button type="button" data-interval="1" aria-pressed="false">1s</button>
          <button type="button" data-interval="5" aria-pressed="true">5s</button>
          <button type="button" data-interval="10" aria-pressed="false">10s</button>
          <button type="button" data-interval="30" aria-pressed="false">30s</button>
          <button type="button" data-interval="60" aria-pressed="false">60s</button>
        </div>
      </div>

      <div class="topbar-spacer"></div>

      <div class="group">
        <span class="label">Theme</span>
        <div class="segmented" id="themePicker" role="group" aria-label="Colour theme">
          <button type="button" data-theme="phosphor" aria-pressed="true" data-tip="Phosphor green">GRN</button>
          <button type="button" data-theme="amber" aria-pressed="false" data-tip="Amber CRT">AMB</button>
          <button type="button" data-theme="ice" aria-pressed="false" data-tip="Ice blue">ICE</button>
          <button type="button" data-theme="daylight" aria-pressed="false" data-tip="Daylight (light mode)">DAY</button>
        </div>
        <button class="btn-x sm icon" id="densityToggle" type="button" aria-pressed="false"
                data-tip="Toggle compact density (D)" aria-label="Toggle density">
          <svg class="ic" aria-hidden="true"><use href="#i-compress"></use></svg>
        </button>
        <button class="btn-x sm icon" id="fxToggle" type="button" aria-pressed="true"
                data-tip="Toggle CRT scanlines and grid drift" aria-label="Toggle visual effects">
          <svg class="ic" aria-hidden="true"><use href="#i-wand-magic-sparkles"></use></svg>
        </button>
      </div>
    </div>

    <!-- ================= Main ================= -->
    <main class="main">

      <!-- KPI strip -->
      <section class="kpi-strip" aria-label="Key metrics">
        <article class="kpi" style="--kpi-tint: var(--info)">
          <div class="kpi-head">
            <span class="icon"><svg class="ic" aria-hidden="true"><use href="#i-bolt"></use></svg></span>
            <span class="title">Active Workflows</span>
          </div>
          <div class="kpi-body">
            <span class="kpi-value num" id="kpiActive" data-value="0">{{.ActiveWorkflows}}</span>
            <svg class="kpi-spark" id="sparkActive" aria-hidden="true"></svg>
          </div>
          <div class="kpi-foot">
            <span class="kpi-delta flat" id="kpiActiveDelta">—</span>
            <span class="kpi-note">in flight right now</span>
          </div>
        </article>

        <article class="kpi" style="--kpi-tint: var(--accent)">
          <div class="kpi-head">
            <span class="icon"><svg class="ic" aria-hidden="true"><use href="#i-play"></use></svg></span>
            <span class="title">Total Started</span>
          </div>
          <div class="kpi-body">
            <span class="kpi-value num" id="kpiStarted" data-value="0">{{.TotalWorkflowsStarted}}</span>
            <svg class="kpi-spark" id="sparkStarted" aria-hidden="true"></svg>
          </div>
          <div class="kpi-foot">
            <span class="kpi-delta flat" id="kpiStartedDelta">—</span>
            <span class="kpi-note">launched this session</span>
          </div>
        </article>

        <article class="kpi" style="--kpi-tint: var(--ok)">
          <div class="kpi-head">
            <span class="icon"><svg class="ic" aria-hidden="true"><use href="#i-circle-check"></use></svg></span>
            <span class="title">Completed</span>
          </div>
          <div class="kpi-body">
            <span class="kpi-value num" id="kpiCompleted" data-value="0">{{.TotalWorkflowsCompleted}}</span>
            <svg class="kpi-spark" id="sparkCompleted" aria-hidden="true"></svg>
          </div>
          <div class="kpi-foot">
            <span class="kpi-delta flat" id="kpiCompletedDelta">—</span>
            <span class="kpi-note">finished cleanly</span>
          </div>
        </article>

        <article class="kpi" id="kpiFailedTile" style="--kpi-tint: var(--text-3)">
          <div class="kpi-head">
            <span class="icon"><svg class="ic" aria-hidden="true"><use href="#i-triangle-exclamation"></use></svg></span>
            <span class="title">Failed</span>
          </div>
          <div class="kpi-body">
            <span class="kpi-value num" id="kpiFailed" data-value="0">{{.TotalWorkflowsFailed}}</span>
            <svg class="kpi-spark" id="sparkFailed" aria-hidden="true"></svg>
          </div>
          <div class="kpi-foot">
            <span class="kpi-delta flat" id="kpiFailedDelta">—</span>
            <span class="kpi-note">needs attention</span>
          </div>
        </article>

        <article class="kpi gauge-tile" id="kpiSuccessTile" style="--kpi-tint: var(--ok)">
          <div class="kpi-head">
            <span class="icon"><svg class="ic" aria-hidden="true"><use href="#i-bullseye"></use></svg></span>
            <span class="title">Success Rate</span>
          </div>
          <div class="kpi-body">
            <span class="kpi-value num"><span id="kpiSuccessValue">--</span><span class="unit">%</span></span>
            <svg class="gauge" id="successGauge" aria-hidden="true"></svg>
          </div>
          <div class="kpi-foot">
            <span class="kpi-note" id="kpiSuccessNote">awaiting first result</span>
          </div>
        </article>

        <article class="kpi" style="--kpi-tint: var(--violet)">
          <div class="kpi-head">
            <span class="icon"><svg class="ic" aria-hidden="true"><use href="#i-gauge-high"></use></svg></span>
            <span class="title">Throughput</span>
          </div>
          <div class="kpi-body">
            <span class="kpi-value num"><span id="kpiThroughput">0.0</span><span class="unit">wf/min</span></span>
            <svg class="kpi-spark" id="sparkThroughput" aria-hidden="true"></svg>
          </div>
          <div class="kpi-foot">
            <span class="kpi-note" id="kpiThroughputNote">no live processes</span>
          </div>
        </article>
      </section>

      <!-- Charts -->
      <section class="chart-grid" aria-label="Visual analytics">

        <div class="panel span-8">
          <div class="panel-head">
            <h2><svg class="ic" aria-hidden="true"><use href="#i-clock"></use></svg> Workflow Duration</h2>
            <span class="sub">per process, newest on the right</span>
            <div class="tools">
              <div class="segmented" id="windowPicker" role="group" aria-label="Data window">
                <button type="button" data-window="30" aria-pressed="true">30</button>
                <button type="button" data-window="60" aria-pressed="false">60</button>
                <button type="button" data-window="120" aria-pressed="false">120</button>
                <button type="button" data-window="all" aria-pressed="false">ALL</button>
              </div>
              <button class="btn-x sm icon" id="resetDurationZoom" type="button" data-tip="Reset zoom" aria-label="Reset zoom">
                <svg class="ic" aria-hidden="true"><use href="#i-arrows-to-dot"></use></svg>
              </button>
              <button class="btn-x sm icon" id="exportDurationPNG" type="button" data-tip="Export as PNG" aria-label="Export chart as PNG">
                <svg class="ic" aria-hidden="true"><use href="#i-image"></use></svg>
              </button>
              <button class="btn-x sm icon" id="exportDurationCSV" type="button" data-tip="Export as CSV" aria-label="Export chart data as CSV">
                <svg class="ic" aria-hidden="true"><use href="#i-file-csv"></use></svg>
              </button>
            </div>
          </div>
          <div class="panel-body">
            <div class="chart-frame"><canvas id="durationChart"></canvas></div>
            <div class="legend" id="durationLegend"></div>
          </div>
        </div>

        <div class="panel span-4">
          <div class="panel-head">
            <h2><svg class="ic" aria-hidden="true"><use href="#i-chart-pie"></use></svg> Outcomes</h2>
            <span class="sub">completed vs failed</span>
          </div>
          <div class="panel-body">
            <div class="chart-frame short donut-wrap">
              <canvas id="outcomeChart"></canvas>
              <div class="donut-center">
                <span class="big num" id="outcomeCenterValue">--</span>
                <span class="small" id="outcomeCenterLabel">no results yet</span>
              </div>
            </div>
            <div class="legend" id="outcomeLegend"></div>
          </div>
        </div>

        <div class="panel span-8">
          <div class="panel-head">
            <h2><svg class="ic" aria-hidden="true"><use href="#i-microchip"></use></svg> System Resources</h2>
            <span class="sub">CPU averaged across processes · host memory</span>
            <div class="tools">
              <button class="btn-x sm icon" id="resetResourceZoom" type="button" data-tip="Reset zoom" aria-label="Reset zoom">
                <svg class="ic" aria-hidden="true"><use href="#i-arrows-to-dot"></use></svg>
              </button>
              <button class="btn-x sm icon" id="exportResourcePNG" type="button" data-tip="Export as PNG" aria-label="Export chart as PNG">
                <svg class="ic" aria-hidden="true"><use href="#i-image"></use></svg>
              </button>
              <button class="btn-x sm icon" id="exportResourceCSV" type="button" data-tip="Export as CSV" aria-label="Export chart data as CSV">
                <svg class="ic" aria-hidden="true"><use href="#i-file-csv"></use></svg>
              </button>
            </div>
          </div>
          <div class="panel-body">
            <div class="chart-frame"><canvas id="resourceChart"></canvas></div>
            <div class="legend" id="resourceLegend"></div>
          </div>
        </div>

        <div class="panel span-4">
          <div class="panel-head">
            <h2><svg class="ic" aria-hidden="true"><use href="#i-wave-square"></use></svg> Latency Profile</h2>
            <span class="sub">all recorded runs</span>
          </div>
          <div class="panel-body">
            <div class="pct-list" id="pctList"></div>
            <hr class="rule" style="margin: 16px 0 12px">
            <div class="histogram" id="histogram"></div>
            <div class="histo-axis" id="histogramAxis"></div>
            <div class="mini-stats" id="latencyStats" style="margin-top: 14px"></div>
          </div>
        </div>
      </section>

      <!-- Live screen flow.

           Every other panel counts workflows; this one shows the individual
           virtual users and the step of the screen flow each is on right now.
           It is the only view that answers "what is the run doing at this
           second" rather than "how much has it done", and the only one that
           makes a stall legible: forty workers all sat on step 6 is a host
           that will not paint a screen, not a load generator that is busy.

           Hidden entirely when nothing is in flight — the runs table below
           already says a run has ended, and an empty flow panel above it
           would only repeat that. -->
      <section class="panel" id="flowPanel" aria-label="Live screen flow" hidden>
        <div class="panel-head">
          <h2><svg class="ic" aria-hidden="true"><use href="#i-satellite-dish"></use></svg> Live Screen Flow</h2>
          <span class="sub" id="flowCount">no workers in flight</span>
          <div class="tools">
            <label class="switch" data-tip="Show only workers that have sat on one step longer than the stall threshold">
              <input type="checkbox" id="flowStalledOnly">
              <span class="track"></span>
              <span class="switch-label">Stalled only</span>
            </label>
            <div class="segmented" id="flowSort" role="group" aria-label="Sort workers">
              <button type="button" data-sort="onstep" aria-pressed="true" data-tip="Longest on its current step first">Slowest</button>
              <button type="button" data-sort="step" aria-pressed="false" data-tip="By position in the workflow">Step</button>
              <button type="button" data-sort="port" aria-pressed="false" data-tip="By script port">Port</button>
            </div>
          </div>
        </div>

        <div class="panel-body">
          <div class="flow-summary" id="flowSummary"></div>
          <div class="flow-cols">
            <div class="flow-stage">
              <h3 class="flow-subhead">Where the fleet is</h3>
              <div class="stage-list" id="flowStage"></div>
            </div>
            <div class="flow-workers">
              <h3 class="flow-subhead">Workers <span class="flow-subnote" id="flowWorkerNote"></span></h3>
              <div class="worker-list" id="flowWorkers"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Process intelligence -->
      <section class="panel" aria-label="Process intelligence">
        <div class="panel-head">
          <h2><svg class="ic" aria-hidden="true"><use href="#i-diagram-project"></use></svg> Process Intelligence</h2>
          <span class="sub" id="procCount">0 processes</span>
          <div class="tools">
            <div class="segmented" id="viewToggle" role="group" aria-label="Layout">
              <button type="button" data-view="table" aria-pressed="true" data-tip="Table view"><svg class="ic" aria-hidden="true"><use href="#i-table-list"></use></svg></button>
              <button type="button" data-view="cards" aria-pressed="false" data-tip="Card view"><svg class="ic" aria-hidden="true"><use href="#i-table-cells-large"></use></svg></button>
            </div>
            <button class="btn-x sm" id="exportProcesses" type="button" data-tip="Download the current view as CSV">
              <svg class="ic" aria-hidden="true"><use href="#i-file-csv"></use></svg><span class="txt">Export</span>
            </button>
          </div>
        </div>

        <div class="table-toolbar">
          <div class="search-field">
            <svg class="ic" aria-hidden="true"><use href="#i-magnifying-glass"></use></svg>
            <label class="visually-hidden" for="procSearch">Search processes</label>
            <input type="search" id="procSearch" placeholder="Filter by PID, status, params…" autocomplete="off">
            <button class="clear" id="procSearchClear" type="button" hidden aria-label="Clear search">
              <svg class="ic" aria-hidden="true"><use href="#i-xmark"></use></svg>
            </button>
          </div>
          <div class="segmented" id="statusFilter" role="group" aria-label="Status filter">
            <button type="button" data-filter="all" aria-pressed="true">All</button>
            <button type="button" data-filter="running" aria-pressed="false">Running</button>
            <button type="button" data-filter="ended" aria-pressed="false">Ended</button>
            <button type="button" data-filter="failing" aria-pressed="false">With failures</button>
          </div>
          <span class="chip" data-tip="Press / to jump to the filter"><kbd>/</kbd> to search</span>
        </div>

        <div class="grid-wrap" id="procGridWrap">
          <table class="grid" id="procTable">
            <thead>
              <tr>
                <th scope="col">Actions</th>
                <th scope="col" class="sortable" data-key="pid" aria-sort="ascending">PID <span class="sort-ind">↕</span></th>
                <th scope="col" class="sortable" data-key="status">Status <span class="sort-ind">↕</span></th>
                <th scope="col">Progress</th>
                <th scope="col" class="sortable" data-key="activeWorkflows">Active <span class="sort-ind">↕</span></th>
                <th scope="col" class="sortable" data-key="totalWorkflowsStarted">Started <span class="sort-ind">↕</span></th>
                <th scope="col" class="sortable" data-key="totalWorkflowsCompleted">Completed <span class="sort-ind">↕</span></th>
                <th scope="col" class="sortable" data-key="totalWorkflowsFailed">Failed <span class="sort-ind">↕</span></th>
                <th scope="col">Success</th>
                <th scope="col" class="sortable" data-key="avg">Avg Duration <span class="sort-ind">↕</span></th>
                <th scope="col" class="sortable" data-key="params">Parameters <span class="sort-ind">↕</span></th>
              </tr>
            </thead>
            <tbody id="procBody"></tbody>
          </table>
        </div>

        <div class="card-view" id="procCards"></div>

        <div class="empty" id="procEmpty" hidden>
          <div class="glyph"><svg class="ic" aria-hidden="true"><use href="#i-satellite-dish"></use></svg></div>
          <div class="t" id="procEmptyTitle">No processes yet</div>
          <div class="d" id="procEmptyBody">Start a 3270Connect run or a sample app to populate the console.</div>
          <button class="btn-x primary" type="button" onclick="document.getElementById('openStartProcess').click()">
            <svg class="ic" aria-hidden="true"><use href="#i-rocket"></use></svg> Start a process
          </button>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>3270Connect Control Surface · Operator View</span>
      <span>Session v{{.Version}} · &copy; {{.Year}} 3270Connect</span>
      <span class="quip">“Where there's legacy code, there's opportunity.”</span>
    </footer>
  </div>

  <!-- ================= Toasts ================= -->
  <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="false"></div>

  <!-- ================= Command palette ================= -->
  <div class="palette-overlay" id="paletteOverlay" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="palette">
      <div class="palette-input-row">
        <svg class="ic" aria-hidden="true"><use href="#i-terminal"></use></svg>
        <label class="visually-hidden" for="paletteInput">Search commands</label>
        <input type="text" id="paletteInput" placeholder="Type a command, theme or PID…" autocomplete="off" spellcheck="false">
        <kbd>Esc</kbd>
      </div>
      <div class="palette-results" id="paletteResults" role="listbox" aria-label="Commands"></div>
      <div class="palette-foot">
        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span><kbd>⏎</kbd> run</span>
        <span><kbd>Esc</kbd> close</span>
      </div>
    </div>
  </div>

  <!-- ================= Console logs modal ================= -->
  <div class="modal" id="consoleModal" tabindex="-1" aria-labelledby="consoleModalLabel" aria-hidden="true">
    <div class="modal-card xl tall" id="consoleModalDialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="consoleModalLabel"><svg class="ic" aria-hidden="true"><use href="#i-terminal"></use></svg> Console Stream</h5>
          <div class="head-tools">
            <button class="btn-x sm icon" id="consoleMaximize" type="button" aria-pressed="false"
                    data-tip="Maximise" aria-label="Maximise console"><svg class="ic" aria-hidden="true"><use href="#i-expand"></use></svg></button>
            <button type="button" class="btn-close" data-close aria-label="Close"></button>
          </div>
        </div>
        <div class="modal-body">
          <div class="pid-strip" id="logPidStrip"></div>

          <div class="viewer">
            <div class="viewer-bar">
              <label class="visually-hidden" for="logPidFilter">Filter by PID</label>
              <select class="form-select" id="logPidFilter" style="width:auto;min-width:132px" data-tip="Filter by process">
                <option value="">All PIDs</option>
              </select>

              <label class="visually-hidden" for="logLevel">Filter by level</label>
              <select class="form-select" id="logLevel" style="width:auto;min-width:118px" data-tip="Filter by severity">
                <option value="all">All levels</option>
                <option value="error">Errors</option>
                <option value="warn">Warnings</option>
                <option value="ok">Success</option>
              </select>

              <div class="search-field" style="min-width:180px">
                <svg class="ic" aria-hidden="true"><use href="#i-magnifying-glass"></use></svg>
                <label class="visually-hidden" for="logSearch">Search logs</label>
                <input type="search" id="logSearch" placeholder="Search log text…" autocomplete="off">
              </div>

              <span class="spacer"></span>
              <span class="count" id="logCount">0 lines</span>

              <button class="btn-x sm icon" id="logFollow" type="button" aria-pressed="true"
                      data-tip="Follow tail" aria-label="Follow tail"><svg class="ic" aria-hidden="true"><use href="#i-angles-down"></use></svg></button>
              <button class="btn-x sm icon" id="logWrap" type="button" aria-pressed="true"
                      data-tip="Toggle line wrapping" aria-label="Toggle line wrapping"><svg class="ic" aria-hidden="true"><use href="#i-align-left"></use></svg></button>
              <button class="btn-x sm icon" id="logRefresh" type="button" data-tip="Reload" aria-label="Reload logs"><svg class="ic" aria-hidden="true"><use href="#i-rotate"></use></svg></button>
              <button class="btn-x sm icon" id="logCopy" type="button" data-tip="Copy all" aria-label="Copy logs"><svg class="ic" aria-hidden="true"><use href="#i-copy"></use></svg></button>
              <button class="btn-x sm icon" id="logDownload" type="button" data-tip="Download" aria-label="Download logs"><svg class="ic" aria-hidden="true"><use href="#i-download"></use></svg></button>
            </div>
            <div class="viewer-scroll" id="logStream"></div>
          </div>
        </div>
        <div class="modal-footer">
          <label class="switch" data-tip="Poll the log endpoint automatically">
            <input type="checkbox" id="logAutoRefresh">
            <span class="track"></span>
            <span class="switch-label">Auto refresh</span>
          </label>
          <label class="visually-hidden" for="logInterval">Log refresh interval</label>
          <select class="form-select" id="logInterval" style="width:auto">
            <option value="1">1s</option>
            <option value="5" selected>5s</option>
            <option value="10">10s</option>
            <option value="15">15s</option>
            <option value="30">30s</option>
          </select>
          <span class="topbar-spacer"></span>
          <button type="button" class="btn-x" data-close>Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Start process modal ================= -->
  <div class="modal" id="startProcessModal" tabindex="-1" aria-labelledby="startProcessLabel" aria-hidden="true">
    <div class="modal-card xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="startProcessLabel"><svg class="ic" aria-hidden="true"><use href="#i-rocket"></use></svg> Start 3270Connect Process</h5>
          <div class="head-tools">
            <div class="steps" id="startSteps">
              <span class="step"><span class="n">1</span> Config</span>
              <span class="sep"></span>
              <span class="step"><span class="n">2</span> Review</span>
              <span class="sep"></span>
              <span class="step"><span class="n">3</span> Verify</span>
            </div>
            <button type="button" class="btn-close" data-close aria-label="Close"></button>
          </div>
        </div>

        <div class="modal-body">
          <form id="startProcessForm" enctype="multipart/form-data" novalidate>
            <div class="modal-cols">

              <!-- Left column: files + parsed config -->
              <div class="modal-col">
                <div class="field">
                  <label for="configFile">Workflow configuration</label>
                  <div class="dropzone" id="configDrop">
                    <input type="file" id="configFile" name="configFile" accept=".json" required
                           aria-label="Workflow configuration JSON file">
                    <span class="dz-icon"><svg class="ic" aria-hidden="true"><use href="#i-file-arrow-up"></use></svg></span>
                    <span class="dz-title">Drop a workflow JSON here</span>
                    <span class="dz-sub">or click to browse — the file is parsed locally before upload</span>
                  </div>
                  <span class="file-pill" id="configFileName" hidden></span>
                </div>

                <div id="configDetails" hidden>
                  <div class="field">
                    <span class="form-label">Parsed workflow</span>
                    <dl class="meta-list" id="configMeta"></dl>
                  </div>
                  <details class="disclosure" style="margin-top:12px">
                    <summary>Raw configuration</summary>
                    <pre class="code-view" id="configCode" style="max-height:280px"></pre>
                  </details>
                </div>

                <fieldset class="group" id="overrideGroup" hidden>
                  <legend>Overrides</legend>
                  <div class="form-grid">
                    <div class="field">
                      <label for="overrideHost">Host</label>
                      <input type="text" class="form-control" id="overrideHost" placeholder="mainframe.host">
                    </div>
                    <div class="field">
                      <label for="overridePort">Port</label>
                      <input type="number" class="form-control" id="overridePort" min="1" placeholder="3270">
                    </div>
                    <div class="field full">
                      <label for="overrideOutputFilePath">Output file path</label>
                      <input type="text" class="form-control" id="overrideOutputFilePath" placeholder="output.html">
                    </div>
                    <div class="field">
                      <label for="overrideRampUpBatchSize">Ramp-up batch size</label>
                      <input type="number" class="form-control" id="overrideRampUpBatchSize" min="1" placeholder="Leave blank to keep">
                    </div>
                    <div class="field">
                      <label for="overrideRampUpDelay">Ramp-up delay (s)</label>
                      <input type="number" class="form-control" id="overrideRampUpDelay" min="0" step="0.1" placeholder="Leave blank to keep">
                    </div>
                    <div class="full">
                      <button type="button" class="btn-x accentline" id="testConnection">
                        <svg class="ic" aria-hidden="true"><use href="#i-plug"></use></svg><span class="txt">Test connection</span>
                      </button>
                    </div>
                    <div class="full">
                      <div class="banner" id="connectionResult" hidden></div>
                    </div>
                  </div>
                </fieldset>
              </div>

              <!-- Right column: run parameters -->
              <div class="modal-col">
                <fieldset class="group">
                  <legend>Load profile</legend>
                  <div class="form-grid">
                    <div class="field">
                      <label for="concurrent">Concurrent workflows</label>
                      <input type="number" class="form-control" id="concurrent" min="1" value="5" required>
                    </div>
                    <div class="field">
                      <label for="runtime">Runtime (seconds)</label>
                      <input type="number" class="form-control" id="runtime" min="1" value="180" required>
                    </div>
                    <div class="field">
                      <label for="startPort">Starting port</label>
                      <input type="number" class="form-control" id="startPort" min="1" value="5000" required>
                    </div>
                    <div class="field">
                      <label for="headlessWrap">Execution mode</label>
                      <div id="headlessWrap" style="padding-top:6px">
                        <label class="switch" data-tip="Run without the x3270 GUI — recommended for load tests">
                          <input type="checkbox" id="headless" checked>
                          <span class="track"></span>
                          <span class="switch-label">Headless</span>
                        </label>
                      </div>
                    </div>
                  </div>
                </fieldset>

                <fieldset class="group">
                  <legend>Optional inputs</legend>
                  <div class="field">
                    <label for="injectionFile">Injection config (JSON)</label>
                    <input type="file" class="form-control" id="injectionFile" accept=".json">
                    <span class="hint">Supplies dynamic field values at runtime.</span>
                  </div>
                  <div class="field" style="margin-top:12px">
                    <label for="token">RSA token</label>
                    <input type="text" class="form-control" id="token" inputmode="numeric"
                           autocomplete="one-time-code" placeholder="123456">
                    <span class="hint">Replaces <code>{{"{{"}}token{{"}}"}}</code> placeholders immediately before execution.</span>
                  </div>
                </fieldset>

                <div class="banner">
                  <svg class="ic" aria-hidden="true"><use href="#i-circle-info"></use></svg>
                  <span>The console pauses live polling while this dialog is open, and resumes as soon as it closes.</span>
                </div>
              </div>
            </div>
          </form>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-x" data-close>Cancel</button>
          <button type="button" class="btn-x primary" id="startProcessSubmit">
            <svg class="ic" aria-hidden="true"><use href="#i-rocket"></use></svg><span class="txt">Launch run</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Start app modal ================= -->
  <div class="modal" id="startAppModal" tabindex="-1" aria-labelledby="startAppLabel" aria-hidden="true">
    <div class="modal-card sm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="startAppLabel"><svg class="ic" aria-hidden="true"><use href="#i-server"></use></svg> Start Sample 3270 App</h5>
          <button type="button" class="btn-close" data-close aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="field">
            <span class="form-label">Choose an application</span>
            <div class="app-picker" id="appPicker">
              <button type="button" class="app-option" data-app="1" aria-pressed="false">
                <svg class="ic" aria-hidden="true"><use href="#i-right-to-bracket"></use></svg>
                <span class="t">Sample App 1</span>
                <span class="d">Login screen with menu navigation</span>
              </button>
              <button type="button" class="app-option" data-app="2" aria-pressed="false">
                <svg class="ic" aria-hidden="true"><use href="#i-table-columns"></use></svg>
                <span class="t">Sample App 2</span>
                <span class="d">Multi-screen data entry flow</span>
              </button>
            </div>
          </div>
          <div class="field">
            <label for="appPort">Listen port</label>
            <input type="number" class="form-control" id="appPort" min="1" value="3270" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-x" data-close>Cancel</button>
          <button type="button" class="btn-x primary" id="startAppSubmit">
            <svg class="ic" aria-hidden="true"><use href="#i-play"></use></svg><span class="txt">Start app</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Kill modal ================= -->
  <div class="modal" id="killModal" tabindex="-1" aria-labelledby="killLabel" aria-hidden="true">
    <div class="modal-card sm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="killLabel"><svg class="ic" style="color:var(--danger)" aria-hidden="true"><use href="#i-skull-crossbones"></use></svg> Terminate Process</h5>
          <button type="button" class="btn-close" data-close aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="banner bad">
            <svg class="ic" aria-hidden="true"><use href="#i-triangle-exclamation"></use></svg>
            <span>This sends a kill signal immediately. In-flight workflows on this process will not finish.</span>
          </div>
          <dl class="meta-list">
            <dt>PID</dt><dd id="killPid">—</dd>
            <dt>Parameters</dt><dd id="killParams">—</dd>
          </dl>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-x" data-close>Cancel</button>
          <button type="button" class="btn-x danger" id="confirmKill">
            <svg class="ic" aria-hidden="true"><use href="#i-skull-crossbones"></use></svg><span class="txt">Terminate</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Workflow JSON modal ================= -->
  <div class="modal" id="workflowModal" tabindex="-1" aria-labelledby="workflowLabel" aria-hidden="true">
    <div class="modal-card xl tall">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="workflowLabel"><svg class="ic" aria-hidden="true"><use href="#i-file-code"></use></svg> Workflow Definition</h5>
          <div class="head-tools">
            <button class="btn-x sm icon" id="workflowCopy" type="button" data-tip="Copy JSON" aria-label="Copy JSON"><svg class="ic" aria-hidden="true"><use href="#i-copy"></use></svg></button>
            <button class="btn-x sm icon" id="workflowDownload" type="button" data-tip="Download JSON" aria-label="Download JSON"><svg class="ic" aria-hidden="true"><use href="#i-download"></use></svg></button>
            <button type="button" class="btn-close" data-close aria-label="Close"></button>
          </div>
        </div>
        <div class="modal-body">
          <span class="chip" style="align-self:flex-start"><svg class="ic" aria-hidden="true"><use href="#i-folder-open"></use></svg><span id="workflowPath">Unknown</span></span>
          <div class="viewer">
            <pre class="code-view" id="workflowCode">Preparing workflow…</pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Output preview modal ================= -->
  <div class="modal" id="outputModal" tabindex="-1" aria-labelledby="outputLabel" aria-hidden="true">
    <div class="modal-card xl tall">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="outputLabel"><svg class="ic" aria-hidden="true"><use href="#i-display"></use></svg> Live Output Preview</h5>
          <div class="head-tools">
            <button class="btn-x sm icon" id="outputToggle" type="button" aria-pressed="true"
                    data-tip="Pause auto-refresh" aria-label="Toggle auto-refresh"><svg class="ic" aria-hidden="true"><use href="#i-pause"></use></svg></button>
            <label class="visually-hidden" for="outputIntervalSelect">Preview refresh interval</label>
            <select class="form-select" id="outputIntervalSelect" style="width:auto">
              <option value="2000">2s</option>
              <option value="4000" selected>4s</option>
              <option value="8000">8s</option>
              <option value="15000">15s</option>
            </select>
            <button class="btn-x sm icon" id="outputReload" type="button" data-tip="Reload now" aria-label="Reload preview"><svg class="ic" aria-hidden="true"><use href="#i-rotate"></use></svg></button>
            <button type="button" class="btn-close" data-close aria-label="Close"></button>
          </div>
        </div>
        <div class="modal-body">
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <span class="chip"><svg class="ic" aria-hidden="true"><use href="#i-folder-open"></use></svg><span id="outputPath">Path unavailable</span></span>
            <span class="chip accent" id="outputInfo">Auto-refreshing every 4s</span>
            <span class="chip" id="outputStatus">Idle</span>
          </div>
          <iframe id="outputFrame" class="preview-frame" title="Workflow output preview"
                  sandbox="allow-same-origin" srcdoc="<p style='font-family:monospace;padding:16px'>Loading output…</p>"></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Summary modal ================= -->
  <div class="modal" id="summaryModal" tabindex="-1" aria-labelledby="summaryLabel" aria-hidden="true">
    <div class="modal-card xl tall">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="summaryLabel"><svg class="ic" aria-hidden="true"><use href="#i-file-lines"></use></svg> Performance Summary</h5>
          <div class="head-tools">
            <button class="btn-x sm icon" id="summaryCopy" type="button" data-tip="Copy summary" aria-label="Copy summary"><svg class="ic" aria-hidden="true"><use href="#i-copy"></use></svg></button>
            <button class="btn-x sm icon" id="summaryDownload" type="button" data-tip="Download summary" aria-label="Download summary"><svg class="ic" aria-hidden="true"><use href="#i-download"></use></svg></button>
            <button type="button" class="btn-close" data-close aria-label="Close"></button>
          </div>
        </div>
        <div class="modal-body">
          <span class="chip" style="align-self:flex-start"><svg class="ic" aria-hidden="true"><use href="#i-hashtag"></use></svg>PID <span id="summaryPid">—</span></span>
          <div class="viewer">
            <pre class="code-view" id="summaryCode">Loading summary…</pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Shortcut sheet ================= -->
  <div class="modal" id="shortcutModal" tabindex="-1" aria-labelledby="shortcutLabel" aria-hidden="true">
    <div class="modal-card lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="shortcutLabel"><svg class="ic" aria-hidden="true"><use href="#i-keyboard"></use></svg> Keyboard Shortcuts</h5>
          <button type="button" class="btn-close" data-close aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="sheet-grid">
            <div class="sheet-row"><span>Command palette</span><span><kbd>Ctrl</kbd> <kbd>K</kbd></span></div>
            <div class="sheet-row"><span>Focus process filter</span><span><kbd>/</kbd></span></div>
            <div class="sheet-row"><span>Refresh now</span><span><kbd>R</kbd></span></div>
            <div class="sheet-row"><span>Console logs</span><span><kbd>C</kbd></span></div>
            <div class="sheet-row"><span>Start process</span><span><kbd>S</kbd></span></div>
            <div class="sheet-row"><span>Start sample app</span><span><kbd>A</kbd></span></div>
            <div class="sheet-row"><span>Pause / resume polling</span><span><kbd>P</kbd></span></div>
            <div class="sheet-row"><span>Toggle density</span><span><kbd>D</kbd></span></div>
            <div class="sheet-row"><span>Cycle theme</span><span><kbd>T</kbd></span></div>
            <div class="sheet-row"><span>This sheet</span><span><kbd>?</kbd></span></div>
            <div class="sheet-row"><span>Close dialogs</span><span><kbd>Esc</kbd></span></div>
          </div>
          <div class="banner">
            <svg class="ic" aria-hidden="true"><use href="#i-circle-info"></use></svg>
            <span>Charts support scroll-wheel zoom and drag-to-pan. Use the reset button in each panel header to return to the full range.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= Scripts ================= -->
  <script src="/static/vendor/chart.umd.js?v={{.Version}}"></script>
  <script src="/static/vendor/chartjs-plugin-zoom.min.js?v={{.Version}}"></script>
  <script>
    window.__DASH__ = {
      autoRefresh: {{.AutoRefreshEnabled}},
      refreshPeriod: "{{.RefreshPeriod}}",
      version: "{{.Version}}",
      metrics: JSON.parse('{{.ExtendedJSON}}')
    };
  </script>
  <script src="/static/js/dashboard.js?v={{.Version}}"></script>
</body>
</html>
